# ============================================
# NEXKIRANA BACKEND ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual values

# --------------------------------------------
# ADMIN CREDENTIALS
# --------------------------------------------
ADMIN_EMAIL=nexkirana@kirana.com
ADMIN_PASSWORD=qwI41L5U47RwaI47DasA

# --------------------------------------------
# JWT SECURITY (MUST be at least 32 characters)
# --------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long-for-security
JWT_EXPIRES_IN=7d

# --------------------------------------------
# DATABASE CONFIGURATION (TiDB Cloud / MySQL)
# --------------------------------------------
DB_HOST=your-database-host
DB_USER=your-database-user
DB_PASS=your-database-password
DB_NAME=your-database-name
DB_PORT=4000
DB_SSL=true
# DB_SSL_CA=path/to/ca-cert.pem  # Optional: Path to SSL CA certificate

# --------------------------------------------
# CLOUDINARY (Image Upload Service)
# --------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --------------------------------------------
# SERVER CONFIGURATION
# --------------------------------------------
NODE_ENV=development
PORT=5000

# --------------------------------------------
# GOOGLE OAUTH CONFIGURATION
# --------------------------------------------
# Get your Web Client ID from: https://console.cloud.google.com/apis/credentials
# You'll need separate OAuth clients for Android and iOS in Google Console
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# --------------------------------------------
# EMAIL CONFIGURATION (Password Reset)
# --------------------------------------------
# Option 1: Resend (Recommended for Production - FREE 100 emails/day)
# Sign up at https://resend.com/ (no credit card needed)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here
# Must use a verified domain (from resend.com/domains)
RESEND_FROM_EMAIL=resetnexkirana@yourdomain.com
RESEND_FROM_NAME=NexKirana
# Password reset redirect URL (used in email links)
RESET_REDIRECT_URL=https://nexbackend.onrender.com

# Option 2: Gmail SMTP (For Local Development Only - Blocked on Render)
EMAIL_USER=resetnexkirana@gmail.com
EMAIL_PASSWORD=your-gmail-app-specific-password
# Note: Get your Gmail App Password from:
# https://myaccount.google.com/security → App passwords
# Generate a new app password and paste it above (remove spaces)

# --------------------------------------------
# FIREBASE ADMIN SDK (FCM Push Notifications)
# --------------------------------------------
# Firebase Service Account JSON (for production)
# Get from: https://console.firebase.google.com/project/nexkirana-c9da5/settings/serviceaccounts/adminsdk
# Paste the entire JSON content as a single line string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"nexkirana-c9da5","private_key_id":"your-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@nexkirana-c9da5.iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"your-cert-url"}

# Alternative: FIREBASE_SERVICE_ACCOUNT (same as above, for backward compatibility)
# FIREBASE_SERVICE_ACCOUNT=

# --------------------------------------------
# DEPLOYMENT & ENVIRONMENT FLAGS
# --------------------------------------------
# Allow partial environment variables (for deployment platforms like Render)
ALLOW_PARTIAL_ENV=false
RENDER=false

# Staging URL (optional)
STAGING_URL=https://staging-nexbackend.onrender.com

# --------------------------------------------
# RESTOCKING CONFIGURATION
# --------------------------------------------
# Cron schedule for auto-restocking out-of-stock products
# Production: '0 0 * * *' (runs daily at midnight)
# Testing: '* * * * *' (runs every minute)
RESTOCK_CRON_SCHEDULE=0 0 * * *

# --------------------------------------------
# CORS ORIGINS (Auto-configured based on NODE_ENV)
# --------------------------------------------
# Production origins are hardcoded in config/environment.js:
# - https://nexadminpanel.vercel.app
# - https://nexkirana-admin.vercel.app
# - https://nexkirana.vercel.app
# Development: All origins allowed

# --------------------------------------------
# OPTIONAL: PAYMENT GATEWAY (Future Use)
# --------------------------------------------
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# --------------------------------------------
# OPTIONAL: SMS SERVICE (Future Use)
# --------------------------------------------
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number

# --------------------------------------------
# NOTES
# --------------------------------------------
# 1. Never commit .env file to version control (it's in .gitignore)
# 2. Keep this .env.example updated when adding new variables
# 3. Use strong, unique values for JWT_SECRET and passwords
# 4. For production, set NODE_ENV=production
# 5. Enable DB_SSL=true for TiDB Cloud connections
# 6. Firebase service account JSON should be on a single line
# 7. Replace all "your-*" placeholders with actual values
